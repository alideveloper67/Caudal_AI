<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_caratula"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@mipmap/ic_launcher"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Caudal"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/widget_artista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Toca para escuchar música"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_alternar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_boton"
        android:contentDescription="Reproducir"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_play"/>

    <ImageButton
        android:id="@+id/widget_siguiente"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="@android:color/transparent"
        android:contentDescription="Siguiente"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_siguiente"/>
</LinearLayout>
